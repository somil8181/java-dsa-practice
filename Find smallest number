public class Findsmallestnumber {
    public static void main(String[]args){

        int []arr={10,20,30,40,50,60,70,80,90};
        int smallest = arr[0];

        for(int i = 1; i<arr.length; i++){
            if(arr[i] <smallest){
                smallest = arr[i];

            }
        }
        System.out.println("Smallest number : "+smallest);
    }
}
