class Animal{
    void eat(){
        System.out.println("Animal is eating");
    }
}

class Dog extends Animal{
    void bark(){
        System.out.println("Dog is barking");
    }
}

public class Problem{
    public static void main(String[]args){
        Animal a = new Dog();
        a.eat();

        Dog d = (Dog)a;
        d.bark();

    }
}
